# Ambientes Virtuais
venv/
.venv/
env/
.env

# Arquivos compilados do Python
__pycache__/
*.py[cod]
*$py.class

# Logs e dependências do Python
*.log
pip-log.txt
pip-delete-this-directory.txt

# ========================================
