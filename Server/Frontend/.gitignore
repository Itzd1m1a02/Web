node_modules/
/Frontend/node_modules/

# Pastas de build (geradas quando o projeto vai para produção)
dist/
dist-ssr/
build/
/Frontend/dist/

# Logs do NPM
npm-debug.log*
yarn-debug.log*
yarn-error.log*

